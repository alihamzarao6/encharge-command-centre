# --- Pipeline thresholds ------------------------------------------------------
CONFIDENCE_THRESHOLD_REVIEW=0.70
WEBSITE_CONFIDENCE_THRESHOLD=0.80
FUZZY_DEDUPE_THRESHOLD=0.85
