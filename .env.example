SERPER_API_KEY=your-serper-key-here
SERPER_API_BASE=https://google.serper.dev
SERPER_DAILY_QUERY_CAP=500

# --- Anthropic (Claude API) ---------------------------------------------------
# TODO: platform.claude.com → API keys → Create Key (you have access as a member)
ANTHROPIC_API_KEY=
CLAUDE_MODEL_DEFAULT=claude-sonnet-5
CLAUDE_MODEL_FAST=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=4096
# Client agreed $50/month. Daily cap enforced in code BEFORE each call.
ANTHROPIC_MONTHLY_SPEND_CAP_USD=50
ANTHROPIC_DAILY_SPEND_CAP_USD=5

# --- MillionVerifier (email verification) -------------------------------------
