# Account already exists under alihamzarao14@gmail.com with 500 credits.
MILLIONVERIFIER_API_KEY=
MILLIONVERIFIER_API_BASE=https://api.millionverifier.com/api/v3
MILLIONVERIFIER_DAILY_CAP=300

# --- Supabase -----------------------------------------------------------------
# TODO: supabase.com/dashboard → the project (currently PAUSED — restore it first)
#       → Settings → API. Region must be ap-southeast-2 (Sydney).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# SERVER ONLY. n8n + Edge Functions. Never client-side, never in a log line.
SUPABASE_SERVICE_ROLE_KEY=
# Settings → Database → Connection string (URI)
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=raw-pages
# Admin session for `npm run staff` (add-user / deactivate / reset-password). Environment
# only, NEVER on the command line (argv leaks into shell history). Not needed by the
# running system — only by a human admin using the CLI.
STAFF_ADMIN_EMAIL=
STAFF_ADMIN_PASSWORD=

# --- MongoDB Atlas (only if Ross confirms the platform switch) -----------------
# TODO: leave blank unless the database decision changes. See CLAUDE.md section 3.
MONGODB_URI=
MONGODB_DB_NAME=

# --- Notion -------------------------------------------------------------------
# Workspace is "Ross Byrne's Space", teamspace "Ross Byrne's Space HQ".
# BLOCKED (risk R9): creating a connection needs workspace admin. The developer is a
# member, so app.notion.com/developers/connections refuses with "You don't have
# permission to create connections in this workspace". Waiting on Ross for admin
# rights or a token he generates. Not needed to build — only for n8n at runtime.
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Created in task 1.37. Real values live in .env, never here.
NOTION_PARENT_PAGE_ID=00000000000000000000000000000000
# Database IDs — used for page URLs and human navigation.
NOTION_DB_INTAKE=00000000000000000000000000000000
NOTION_DB_ORGANIZATIONS=00000000000000000000000000000000
NOTION_DB_CONTACTS=00000000000000000000000000000000
NOTION_DB_CONSUMER_LEADS=00000000000000000000000000000000
NOTION_DB_REVIEW_QUEUE=00000000000000000000000000000000
NOTION_DB_TASKS=00000000000000000000000000000000
NOTION_DB_SOCIAL=00000000000000000000000000000000
NOTION_DB_OPS_CHAT=00000000000000000000000000000000
# Data source (collection) IDs — REQUIRED for querying and for creating pages.
# A Notion database is a container; rows live in its data source. The API needs these,
# not the database ID above. Get them by fetching a database and reading <data-source>.
NOTION_DS_INTAKE=00000000-0000-0000-0000-000000000000
NOTION_DS_ORGANIZATIONS=00000000-0000-0000-0000-000000000000
NOTION_DS_CONTACTS=00000000-0000-0000-0000-000000000000
NOTION_DS_CONSUMER_LEADS=00000000-0000-0000-0000-000000000000
NOTION_DS_REVIEW_QUEUE=00000000-0000-0000-0000-000000000000
NOTION_DS_TASKS=00000000-0000-0000-0000-000000000000
NOTION_DS_SOCIAL=00000000-0000-0000-0000-000000000000
NOTION_DS_OPS_CHAT=00000000-0000-0000-0000-000000000000
# Notion allows 3 requests/second per token. The client in task 1.39 enforces it.
NOTION_RATE_LIMIT_RPS=3

