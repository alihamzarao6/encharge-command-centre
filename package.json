{
  "name": "encharge-command-centre",
  "version": "0.1.0",
  "private": true,
  "description": "AI assistant for Encharge Capital / Fundd — voice-trained, persistent memory, website reading, content generation, dashboard over GoHighLevel and Meta",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage tests/unit",
    "test:int": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:regress": "npm run typecheck && npm run lint && vitest run --coverage && vitest run tests/integration tests/security",
    "secrets:scan": "gitleaks detect --source . --redact --no-banner",
    "staff": "tsx scripts/staff.ts",
    "chat": "tsx scripts/chat.ts",
    "voice": "tsx scripts/voice.ts",
    "functions:bundle": "tsx scripts/bundle-functions.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "web:check": "tsx scripts/check-bundle.ts",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "memory": "tsx scripts/memory.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@supabase/supabase-js": "^2.112.3",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "supabase": "^2.115.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
